---
interface Props {
  title: string;
  summary: string;
  slug: string;
  vertical: string;
  client?: string;
}

const { title, summary, slug, vertical, client } = Astro.props;

const vColors: Record<string, string> = {
  'Utilities':     '#1D7EAA',
  'Life Sciences': '#0EA898',
  'Other':         '#6B5CF6',
};
const color = vColors[vertical] ?? '#3C9DCC';
---
<article class="cs-card-home" style={`--vc: ${color}`}>
  <div class="cs-card-home-accent"></div>
  <div class="cs-card-home-body">
    <div class="cs-card-home-meta">
      <span class="cs-card-home-badge">{vertical}</span>
      {client && <span class="cs-card-home-client">{client}</span>}
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    <a href={`case-studies/${slug}`} class="cs-card-home-link">Read case study →</a>
  </div>
</article>

<style>
.cs-card-home {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-blue-pale);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.cs-card-home:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
  border-color: color-mix(in srgb, var(--vc, #3C9DCC) 30%, transparent);
}

.cs-card-home-accent {
  height: 3px;
  background: var(--vc, var(--color-blue));
  flex-shrink: 0;
}

.cs-card-home-body {
  padding: var(--space-6);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.cs-card-home-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.cs-card-home-badge {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  background: color-mix(in srgb, var(--vc, #3C9DCC) 12%, transparent);
  color: var(--vc, var(--color-blue));
  border: 1px solid color-mix(in srgb, var(--vc, #3C9DCC) 25%, transparent);
}

.cs-card-home-client {
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  color: var(--color-slate-gray);
  opacity: 0.65;
}

.cs-card-home h3 {
  font-size: var(--text-lg);
  line-height: 1.25;
  letter-spacing: -0.02em;
  margin: 0;
  color: var(--color-slate);
}

.cs-card-home p {
  color: var(--color-slate-gray);
  font-size: var(--text-sm);
  line-height: 1.6;
  margin: 0;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cs-card-home-link {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--vc, var(--color-blue));
  text-decoration: none;
  margin-top: var(--space-2);
  transition: opacity 0.15s;
  align-self: flex-start;
}

.cs-card-home-link:hover {
  opacity: 0.75;
  text-decoration: none;
}
</style>
