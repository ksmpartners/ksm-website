---
interface Props {
  vertical: string;
  size?: number;
}
const { vertical, size = 12 } = Astro.props;
---

{vertical === 'Utilities' && (
  <svg viewBox="0 0 16 16" fill="currentColor" width={size} height={size} aria-hidden="true">
    <path d="M9.5 1 3.5 9.5H8l-2 5.5 6.5-7.5H8L9.5 1Z"/>
  </svg>
)}

{vertical === 'Life Sciences' && (
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
       stroke-linecap="round" stroke-linejoin="round"
       width={size} height={size} aria-hidden="true">
    <path d="M6 1v5L2.5 12.5A1 1 0 0 0 3.4 14h9.2a1 1 0 0 0 .9-1.5L10 6V1"/>
    <path d="M5.5 1h5"/>
    <circle cx="7" cy="11" r=".75" fill="currentColor" stroke="none"/>
    <circle cx="10" cy="12" r=".75" fill="currentColor" stroke="none"/>
  </svg>
)}

{vertical === 'Other' && (
  <svg viewBox="0 0 16 16" fill="currentColor" width={size} height={size} aria-hidden="true">
    <path d="M1 1h6v6H1zM9 1h6v6H9zM1 9h6v6H1zM9 9h6v6H9z"/>
  </svg>
)}
