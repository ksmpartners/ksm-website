---
const services = [
  { label: 'Software Engineering', href: 'services/software-engineering' },
  { label: 'Cloud Migration', href: 'services/cloud-migration' },
  { label: 'Systems Integration', href: 'services/systems-integration' },
  { label: 'Delivery Automation', href: 'services/delivery-automation' },
  { label: 'Project Management', href: 'services/project-management' },
  { label: 'Test Automation', href: 'services/test-automation' },
];

const solutions = [
  { label: 'GxP Migration', href: 'services/gxp-migration' },
];
---
<nav aria-label="Main navigation" style="display:contents">
  <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="nav-toggle">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <ul class="nav-links" id="nav-links">
    <li><a href="">Home</a></li>
    <li class="nav-dropdown">
      <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false" id="services-toggle">
        Services <span class="arrow">▾</span>
      </button>
      <ul class="dropdown-menu" id="services-menu" role="menu">
        {services.map(s => (
          <li role="menuitem"><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </li>
    <li class="nav-dropdown">
      <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false" id="solutions-toggle">
        Solutions <span class="arrow">▾</span>
      </button>
      <ul class="dropdown-menu" id="solutions-menu" role="menu">
        {solutions.map(s => (
          <li role="menuitem"><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </li>
    <li><a href="case-studies">Case Studies</a></li>
    <li><a href="about">About</a></li>
    <li><a href="blog">Blog</a></li>
  </ul>

  <div class="nav-cta">
    <a href="contact" class="btn btn-teal">Schedule a Call</a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  function setupDropdown(toggleId: string, menuId: string) {
    const btn = document.getElementById(toggleId);
    const menu = document.getElementById(menuId);
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  }

  setupDropdown('services-toggle', 'services-menu');
  setupDropdown('solutions-toggle', 'solutions-menu');
</script>
