---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();

function readTime(post: any): string {
  const words = (post.body ?? '').split(/\s+/).length;
  const mins = Math.max(1, Math.round(words / 200));
  return `${mins} min read`;
}

const featured = allPosts[0];
const rest = allPosts.slice(1);

// Tag → accent color mapping (extends gracefully for new tags)
const tagColors: Record<string, string> = {
  'Life Sciences':          '#0EA898',
  'DevOps':                 '#3C9DCC',
  'Compliance':             '#6B5CF6',
  'Validation':             '#E07B2A',
  'Utilities':              '#1D7EAA',
  'Digital Transformation': '#3C9DCC',
  'Cloud':                  '#22C4A0',
  'Data':                   '#004D71',
  'Software Quality':         '#004D71',
  'Continuous Delivery':      '#3C9DCC',
  'API Design':               '#E07B2A',
  'Best Practices':           '#22C4A0',
  'Requirements':             '#6B5CF6',
  'Professional Development': '#0EA898',
};
function tagColor(tag: string) { return tagColors[tag] ?? '#3C9DCC'; }
function primaryColor(tags: string[]) { return tagColor(tags[0] ?? ''); }
---

<PageLayout title="Blog" description="Insights and perspectives from KSM Technology Partners on technology in utilities and life sciences.">

  <!-- ── Blog hero header ── -->
  <div class="blog-hero">
    <div class="container">
      <span class="overline">Insights &amp; Perspectives</span>
      <h1 class="blog-hero-title">From the Field</h1>
      <p class="blog-hero-sub">Practical thinking on technology delivery in utilities, life sciences, and complex regulated environments.</p>

      <!-- Tag filter pills -->
      <div class="blog-filters" role="group" aria-label="Filter by topic">
        <button class="filter-pill active" data-filter="all">All</button>
        {allTags.map(tag => (
          <button class="filter-pill" data-filter={tag} style={`--pill-color: ${tagColor(tag)}`}>{tag}</button>
        ))}
      </div>
    </div>
  </div>

  <div class="section blog-section">

    <!-- ── Featured post ── -->
    {featured && (
      <div class="featured-post" data-tags={featured.data.tags.join(',')}>
        <div class="featured-accent" style={`background: ${primaryColor(featured.data.tags)}`}></div>
        <div class="featured-content" style={`--featured-color: ${primaryColor(featured.data.tags)}`}>
          <div class="featured-meta">
            <div class="featured-tags">
              {featured.data.tags.map((t: string) => (
                <span class="blog-tag" style={`--tag-color: ${tagColor(t)}`}>{t}</span>
              ))}
            </div>
            <span class="blog-read-time">{readTime(featured)}</span>
          </div>
          <h2 class="featured-title">
            <a href={`/blog/${featured.id.replace(/\.mdx?$/, '')}`}>{featured.data.title}</a>
          </h2>
          <p class="featured-excerpt">{featured.data.excerpt}</p>
          <div class="featured-footer">
            <div class="author-chip">
              <div class="author-avatar" style={`background: ${primaryColor(featured.data.tags)}`}>
                {(featured.data.author ?? 'KSM Team').charAt(0)}
              </div>
              <span>{featured.data.author ?? 'KSM Team'}</span>
              <span class="sep">·</span>
              <time datetime={featured.data.date.toISOString()}>
                {featured.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <a href={`/blog/${featured.id.replace(/\.mdx?$/, '')}`} class="btn btn-primary featured-cta">Read article →</a>
          </div>
        </div>
        <div class="featured-visual">
          <div class="featured-visual-inner" style={`background: linear-gradient(135deg, ${primaryColor(featured.data.tags)}18 0%, ${primaryColor(featured.data.tags)}06 100%)`}>
            <div class="featured-quote-mark">"</div>
            <p class="featured-pull-quote">{featured.data.excerpt?.split('.')[0]}.</p>
          </div>
        </div>
      </div>
    )}

    <!-- ── Rest of posts ── -->
    {rest.length > 0 && (
      <div class="posts-grid" id="posts-grid">
        {rest.map(post => {
          const color = primaryColor(post.data.tags);
          const slug = post.id.replace(/\.mdx?$/, '');
          const rt = readTime(post);
          return (
            <article class="post-card" data-tags={post.data.tags.join(',')}>
              <div class="post-card-accent" style={`background: ${color}`}></div>
              <div class="post-card-body">
                <div class="post-card-meta-top">
                  <div class="post-tags">
                    {post.data.tags.map((t: string) => (
                      <span class="blog-tag" style={`--tag-color: ${tagColor(t)}`}>{t}</span>
                    ))}
                  </div>
                  <span class="blog-read-time">{rt}</span>
                </div>
                <h3 class="post-card-title">
                  <a href={`/blog/${slug}`}>{post.data.title}</a>
                </h3>
                <p class="post-card-excerpt">{post.data.excerpt}</p>
              </div>
              <div class="post-card-footer">
                <div class="author-chip small">
                  <div class="author-avatar small" style={`background: ${color}`}>
                    {(post.data.author ?? 'KSM Team').charAt(0)}
                  </div>
                  <span>{post.data.author ?? 'KSM Team'}</span>
                  <span class="sep">·</span>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </time>
                </div>
                <a href={`/blog/${slug}`} class="post-read-link">Read →</a>
              </div>
            </article>
          );
        })}
      </div>
    )}

    <!-- Empty state when filter yields nothing -->
    <div class="no-posts" id="no-posts" style="display:none">
      <p>No articles found for this topic yet — check back soon.</p>
    </div>

  </div>

</PageLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const featured = document.querySelector<HTMLElement>('.featured-post');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');
  const noResults = document.getElementById('no-posts');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter ?? 'all';

      // Update active pill
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      // Filter featured
      if (featured) {
        const ftags = (featured.dataset.tags ?? '').split(',');
        featured.style.display = (filter === 'all' || ftags.includes(filter)) ? '' : 'none';
      }

      // Filter grid cards
      let visible = 0;
      cards.forEach(card => {
        const ctags = (card.dataset.tags ?? '').split(',');
        const show = filter === 'all' || ctags.includes(filter);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (noResults) noResults.style.display = (visible === 0 && (!featured || featured.style.display === 'none')) ? 'block' : 'none';
    });
  });
</script>

<style>
/* ── Blog hero ── */
.blog-hero {
  background: linear-gradient(160deg, var(--color-slate) 0%, #0f1f2c 100%);
  padding: var(--space-16) var(--space-6) var(--space-12);
  position: relative;
  overflow: hidden;
}

.blog-hero::before {
  content: '';
  position: absolute;
  top: -60px; right: -80px;
  width: 480px; height: 480px;
  background: radial-gradient(circle, rgba(60,157,204,0.18) 0%, transparent 70%);
  pointer-events: none;
}

.blog-hero .overline { color: var(--color-teal); }

.blog-hero-title {
  color: #fff;
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.05;
  margin-bottom: var(--space-4);
}

.blog-hero-sub {
  color: rgba(255,255,255,0.6);
  font-size: var(--text-lg);
  max-width: 560px;
  margin-bottom: var(--space-8);
  line-height: 1.6;
}

/* ── Filter pills ── */
.blog-filters {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.filter-pill {
  padding: 0.35rem 0.9rem;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.07);
  color: rgba(255,255,255,0.7);
  font-size: var(--text-sm);
  font-family: var(--font-sans);
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.filter-pill:hover {
  background: rgba(255,255,255,0.14);
  color: #fff;
  border-color: rgba(255,255,255,0.35);
}

.filter-pill.active {
  background: var(--pill-color, var(--color-teal));
  border-color: var(--pill-color, var(--color-teal));
  color: #fff;
}

/* ── Section ── */
.blog-section {
  padding-top: var(--space-12);
}

/* ── Featured post ── */
.featured-post {
  display: grid;
  grid-template-columns: 1fr;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  margin-bottom: var(--space-12);
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.featured-post:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 48px rgba(29, 47, 61, 0.16);
}

.featured-accent {
  height: 4px;
  width: 100%;
}

.featured-content {
  padding: var(--space-8) var(--space-8) var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.featured-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.featured-tags { display: flex; gap: var(--space-2); flex-wrap: wrap; }

.blog-tag {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  font-family: var(--font-mono);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: color-mix(in srgb, var(--tag-color, #3C9DCC) 12%, transparent);
  color: var(--tag-color, var(--color-blue));
  border: 1px solid color-mix(in srgb, var(--tag-color, #3C9DCC) 25%, transparent);
}

.blog-read-time {
  font-size: var(--text-xs);
  color: var(--color-slate-gray);
  font-family: var(--font-mono);
  opacity: 0.7;
  margin-left: auto;
}

.featured-title {
  font-size: clamp(1.5rem, 3vw, 2.1rem);
  line-height: 1.2;
  letter-spacing: -0.03em;
  margin: 0;
}

.featured-title a {
  color: var(--color-slate);
  text-decoration: none;
}

.featured-title a:hover { color: var(--color-blue); }

.featured-excerpt {
  color: var(--color-slate-gray);
  font-size: var(--text-lg);
  line-height: 1.65;
  margin: 0;
  max-width: 640px;
}

.featured-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

.author-chip {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-slate-gray);
}

.author-chip.small { font-size: var(--text-xs); }

.author-avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: var(--text-sm);
  flex-shrink: 0;
}

.author-avatar.small {
  width: 24px; height: 24px;
  font-size: var(--text-xs);
}

.sep { opacity: 0.4; }

.featured-cta { white-space: nowrap; }

/* Featured visual panel */
.featured-visual { display: none; }

.featured-visual-inner {
  height: 100%;
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-10);
  gap: var(--space-6);
}

.featured-quote-mark {
  font-size: 7rem;
  line-height: 0.7;
  color: var(--color-blue);
  opacity: 0.18;
  font-family: Georgia, serif;
  align-self: flex-start;
}

.featured-pull-quote {
  font-size: var(--text-xl);
  line-height: 1.5;
  color: var(--color-slate);
  font-weight: 500;
  font-style: italic;
  margin: 0;
}

/* ── Posts grid ── */
.posts-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

/* ── Post card ── */
.post-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  border: 1px solid var(--color-blue-pale);
}

.post-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
  border-color: transparent;
}

.post-card-accent {
  height: 3px;
  width: 100%;
  flex-shrink: 0;
}

.post-card-body {
  padding: var(--space-6);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.post-card-meta-top {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.post-tags { display: flex; gap: var(--space-2); flex-wrap: wrap; }

.post-card-title {
  font-size: var(--text-xl);
  line-height: 1.25;
  letter-spacing: -0.025em;
  margin: 0;
  flex: 1;
}

.post-card-title a {
  color: var(--color-slate);
  text-decoration: none;
}

.post-card-title a:hover { color: var(--color-blue); }

.post-card-excerpt {
  color: var(--color-slate-gray);
  font-size: var(--text-base);
  line-height: 1.6;
  margin: 0;
  /* Clamp to 3 lines */
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card-footer {
  padding: var(--space-4) var(--space-6);
  border-top: 1px solid var(--color-blue-pale);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  background: rgba(243, 246, 248, 0.5);
}

.post-read-link {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-blue);
  text-decoration: none;
  white-space: nowrap;
  transition: color 0.15s;
}

.post-read-link:hover {
  color: var(--color-teal);
  text-decoration: none;
}

/* ── No results ── */
.no-posts {
  padding: var(--space-16);
  text-align: center;
  color: var(--color-slate-gray);
  font-size: var(--text-lg);
  opacity: 0.7;
}

/* ── Responsive ── */
@media (min-width: 768px) {
  .featured-post {
    grid-template-columns: 3fr 2fr;
  }

  .featured-accent {
    display: none;
  }

  .featured-content {
    border-left: 4px solid var(--featured-color, var(--color-blue));
  }

  .featured-visual {
    display: flex;
    align-items: stretch;
  }

  .posts-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .featured-content {
    padding: var(--space-10);
  }

  .posts-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>
