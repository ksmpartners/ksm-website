---
import PageLayout from '../layouts/PageLayout.astro';
import teamData from '../content/about/our-team.json';

const members = (teamData.members ?? []).slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<PageLayout
  title="Our Team"
  description="Meet the KSM Technology Partners leadership team."
>
  <section class="section">
    <div class="section-heading centered">
      <h1>Our Team</h1>
      <p>
        KSM is a 100% employee-owned company. Our management team is fully engaged in serving clients —
        there are no silent partners.
      </p>
    </div>

    <div class="grid-3 team-grid">
      {members.map((m) => (
        <article class="card team-card">
            <div class="team-media">
              <img
                src={`${import.meta.env.BASE_URL}${m.image}`}
                alt={m.name}
                loading="lazy"
                width="300"
                height="300"
              />
            </div>
            <div class="team-body">
              <h2 class="team-name">{m.name}</h2>
              {m.title ? <p class="team-title">{m.title}</p> : null}
              {m.bio ? <p class="team-bio">{m.bio}</p> : null}
            </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .team-grid {
    background: var(--color-slate);
    margin-top: 0.25rem;
    padding: 1rem;
  }

  .team-card {
    padding: 0;
    overflow: hidden;
  }

  .team-link {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .team-media {
    position: relative;
    aspect-ratio: 1 / 1;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(60, 180, 229, 0.22) 0%, rgba(0, 77, 113, 0.08) 45%, rgba(0, 0, 0, 0) 70%),
      radial-gradient(120% 120% at 100% 100%, rgba(0, 77, 113, 0.18) 0%, rgba(60, 180, 229, 0.10) 35%, rgba(0, 0, 0, 0) 70%),
      rgba(0, 77, 113, 0.03);
  }

  .team-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.02) contrast(1.02);
    transform: scale(1.001);
  }

  .team-body {
    padding: 1.1rem 1.15rem 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .team-name {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .team-title {
    margin: 0;
    color: rgba(0, 77, 113, 0.86);
    font-weight: 700;
  }

  .team-bio {
    margin: 0.3rem 0 0;
    color: rgba(17, 24, 39, 0.86);
    line-height: 1.65;
  }

  .team-cta {
    margin-top: 0.55rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .team-link:focus-visible {
    outline: 3px solid rgba(60, 180, 229, 0.55);
    outline-offset: 3px;
    border-radius: var(--radius);
  }

  .team-link:hover .team-media img {
    transform: scale(1.02);
    transition: transform 220ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .team-link:hover .team-cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .team-body {
      padding: 1rem 1rem 1.1rem;
    }
  }
</style>

