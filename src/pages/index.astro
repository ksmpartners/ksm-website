---
import PageLayout from '../layouts/PageLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import SolutionCard from '../components/SolutionCard.astro';
import { getCollection } from 'astro:content';

const allCaseStudies = await getCollection('case-studies');
const featuredCaseStudies = allCaseStudies
  .filter(cs => cs.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const solutions = [
  {
    title: 'Clinical trials data analysis and reporting',
    body: 'GxP-compliant statistical computing environments for processing clinical trials data into submission-ready results using orchestrated data pipelines and modern data science tools — shrinking cycle times from first patient to analysis completion.',
    image: 'gxp-delivery-automation.jpg',
    alt: 'GxP-compliant clinical-trial data pipeline',
    link: 'case-studies/statistical-computing-environment',
  },
  {
    title: 'AI-powered sentiment detection',
    body: 'AI-powered sentiment analyses across high volumes of textual data to detect emerging signals about therapies and preemptively answer questions from healthcare providers and patients.',
    image: 'data-engineering.jpg',
    alt: 'AI-powered therapy signal detection',
    link: 'case-studies/data-engineering',
  },
  {
    title: 'Bioinformatics pipelines',
    body: 'Our Nextfuse solution runs Nextflow® pipelines in the Domino Data Science platform for controlled and cost-effective analysis execution. Whether for RNA sequencing, variant calling, or other bioinformatics workflows, we can help you get up and running fast and with full GxP compliance.',
    image: 'clinical-data-analysis.jpg',
    alt: 'Reproducible bioinformatics analysis',
    link: 'services/nextfuse',
  },
  {
    title: 'Real-time power flow calculation',
    body: 'Mission-critical nodal calculation platform for an Independent System Operator that computes real-time electricity flow across interfaces with neighboring ISOs. Ingests, processes, and indexes 300+ GB of data per day, integrates with more than a dozen upstream systems, and retains five years of records for audit and re-execution.',
    image: 'real-time-power-flow.jpg',
    alt: 'Real-time power flow calculation engine',
    link: 'case-studies/real-time-power-flow',
  },
];
---
<PageLayout title="Home" description="KSM Technology Partners — Custom software and systems integration for Regulated Industries.">

  <!-- Hero -->
  <section class="hero" style="min-height: 55vh;">
    <div class="hero-panels">
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-left.webp)`}></div>
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-center.webp)`}></div>
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-right.webp)`}></div>
    </div>
    <!-- <span class="overline">Computing solutions for data-intensive workloads in regulated industries</span> -->
    <h1>Innovate. Execute. Empower.</h1>
    <p>Innovative computing solutions for data-intensive workloads in regulated industries.</p>
    <div class="hero-actions">
      <a href="contact" class="btn btn-teal">Schedule a Discovery Call</a>
    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stats-bar-inner">
      <div class="stat-item">
        <span class="stat-num">23+ years</span>
        <span class="stat-label">Delivering results</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">75+</span>
        <span class="stat-label">Completed projects</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">0</span>
        <span class="stat-label">Slideware specialists</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Fueled by passion</span>
      </div>
    </div>
  </div>

  <!-- Solutions -->
  <div class="section-pale">
    <div class="section">
      <div class="section-heading centered">
        <span class="overline">What We Deliver</span>
        <h2>Solutions for data-intensive workloads where compliance is non-negotiable</h2>
        <p>We deliver solutions that transform mission-critical data assets into submission-ready artifacts that auditors can sign off on. Our domain experts have over 20 years of experience in the utilities and life sciences industries, and we understand their unique regulatory requirements. Below are some of the solutions we've successfully delivered.</p>
      </div>
      <div class="solutions-grid">
        {solutions.map(s => (
          <SolutionCard
            title={s.title}
            body={s.body}
            image="https://placehold.co/800x400/004D71/FFFFFF?text=Image+TBD"
            alt={s.alt}
            imagePosition={s.imagePosition}
            wide={s.wide}
            link={s.link}
          />
        ))}
      </div>
    </div>
  </div>

  <!-- Case Study Highlights -->
  <div class="section">
    <div class="section-heading centered">
      <span class="overline">Client Work</span>
      <h2>Recent Engagements</h2>
      <p>Real outcomes for organizations where failure isn't an option.</p>
    </div>
    <div class="grid-3">
      {featuredCaseStudies.map(cs => (
        <CaseStudyCard
          title={cs.data.title}
          summary={cs.data.summary}
          slug={cs.id.replace(/\.mdx?$/, '')}
          vertical={cs.data.vertical}
          client={cs.data.client}
        />
      ))}
    </div>
    <div class="text-center mt-2">
      <a href="case-studies" class="btn-ghost btn">View All Case Studies</a>
    </div>
  </div>

  <!-- About Blurb -->
  <div class="section-pale">
    <div class="section">
      <div style="max-width: 720px; margin: 0 auto; text-align: center;">
        <span class="overline">About Us</span>
        <h2>Solutions-focused Innovation</h2>
        <p style="font-size: var(--text-lg); color: var(--color-slate-gray); line-height: 1.65;">
          KSM Technology Partners combines deep domain expertise in utilities and life sciences with modern engineering practices. We write code, design systems, and work alongside your team — not above it.
        </p>
        <a href="about" class="btn-ghost btn" style="margin-top: var(--space-4);">Learn More About Us</a>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta-banner">
    <span class="overline" style="color: var(--color-teal);">Get Started</span>
    <h2>Ready to Build Something That Works?</h2>
    <p>Tell us about your project and we'll help you find the right path forward.</p>
    <a href="contact" class="btn btn-teal">Contact Us</a>
  </div>

</PageLayout>

<style>
  .solutions-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-flow: dense;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
