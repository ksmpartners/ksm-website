---
import PageLayout from '../layouts/PageLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const allCaseStudies = await getCollection('case-studies');
const featuredCaseStudies = allCaseStudies
  .filter(cs => cs.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<PageLayout title="Home" description="KSM Technology Partners — Custom software and systems integration for Utilities and Life Sciences.">

  <!-- Hero -->
  <section class="hero" style={`background-image: linear-gradient(rgba(29,47,61,0.78), rgba(29,47,61,0.78)), url(${import.meta.env.BASE_URL}images/hero.webp); background-size: cover; background-position: top;`}>
    <span class="overline">GxP-Validated Technology Consulting</span>
    <h1>Custom Software &amp; Integration for Utilities and Life Sciences</h1>
    <p>KSM delivers engineering-led solutions that connect complex systems, accelerate delivery, and satisfy the demands of regulated industries.</p>
    <div class="hero-actions">
      <a href="contact" class="btn btn-teal">Schedule a Discovery Call</a>
      <a href="services/software-engineering" class="btn btn-outline">See Our Services</a>
    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stats-bar-inner">
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Audit Pass Rate</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">15+</span>
        <span class="stat-label">Validated Migrations</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">2</span>
        <span class="stat-label">Industry Verticals</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">10+</span>
        <span class="stat-label">Years of Experience</span>
      </div>
    </div>
  </div>

  <!-- Services Grid -->
  <div class="section-pale">
    <div class="section">
      <div class="section-heading centered">
        <span class="overline">What We Do</span>
        <h2>End-to-End Technology Services</h2>
        <p>From validated environments to modern delivery pipelines — we cover the full stack.</p>
      </div>
      <div class="grid-3">
        {services.map(service => {
          const slug = service.id.replace(/\.mdx?$/, '');
          return (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              slug={slug}
            />
          );
        })}
      </div>
    </div>
  </div>

  <!-- Case Study Highlights -->
  <div class="section">
    <div class="section-heading centered">
      <span class="overline">Client Work</span>
      <h2>Recent Engagements</h2>
      <p>Real outcomes for organizations where failure isn't an option.</p>
    </div>
    <div class="grid-3">
      {featuredCaseStudies.map(cs => (
        <CaseStudyCard
          title={cs.data.title}
          summary={cs.data.summary}
          slug={cs.id.replace(/\.mdx?$/, '')}
          vertical={cs.data.vertical}
          client={cs.data.client}
        />
      ))}
    </div>
    <div class="text-center mt-2">
      <a href="case-studies" class="btn-ghost btn">View All Case Studies</a>
    </div>
  </div>

  <!-- About Blurb -->
  <div class="section-pale">
    <div class="section">
      <div style="max-width: 720px; margin: 0 auto; text-align: center;">
        <span class="overline">About Us</span>
        <h2>Engineers First. Consultants Second.</h2>
        <p style="font-size: var(--text-lg); color: var(--color-slate-gray); line-height: 1.65;">
          KSM Technology Partners combines deep domain expertise in utilities and life sciences with modern engineering practices. We write code, design systems, and work alongside your team — not above it.
        </p>
        <a href="about" class="btn-ghost btn" style="margin-top: var(--space-4);">Learn More About Us</a>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta-banner">
    <span class="overline" style="color: var(--color-teal);">Get Started</span>
    <h2>Ready to Build Something That Works?</h2>
    <p>Tell us about your project and we'll help you find the right path forward.</p>
    <a href="contact" class="btn btn-teal">Contact Us</a>
  </div>

</PageLayout>
